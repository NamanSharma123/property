# Copy to .env and fill in — same core variables as the Node backend
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=your-jwt-secret
# Set to false for a local Postgres without SSL (Supabase needs true)
DB_SSL=true

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Kolkata

# Celery (optional — only for scheduled/async features)
REDIS_URL=redis://localhost:6379/0
