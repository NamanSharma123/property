# Copy to .env and fill in — same core variables as the Node backend
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=your-jwt-secret
# Set to false for a local Postgres without SSL (Supabase needs true)
DB_SSL=true

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Kolkata

# Celery (optional — only for scheduled/async features)
REDIS_URL=redis://localhost:6379/0

# Document storage (optional locally — uploads just fail gracefully if unset;
# required in production so uploaded statements/receipts persist across deploys)
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=ap-southeast-2

# Email (password reset). Leave EMAIL_HOST_PASSWORD blank locally — emails
# print to the console instead of sending, so you can test the flow without
# real credentials. In production this needs a Gmail "App Password" (not the
# regular account password) from Google Account -> Security -> App Passwords.
FRONTEND_URL=http://localhost:3000
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Domain for each user's permanent inbound OCR-ingestion email address
# (admin panel "Unique OCR Email"). Just names the address locally — actually
# receiving mail sent to it needs real AWS SES inbound receipt rules + this
# domain's MX records, set up separately when that phase is built.
INBOUND_EMAIL_DOMAIN=properlymail.com.au
# Shared secret the SES-inbound webhook (POST /api/email/inbound) requires
# in an X-Inbound-Secret header. Leave blank locally to keep it closed;
# set a real random value once wiring the live AWS SES integration.
INBOUND_EMAIL_WEBHOOK_SECRET=
